--- a/scripts/Invoke-QA.ps1
+++ b/scripts/Invoke-QA.ps1
@@ -0,0 +1,63 @@
+param(
+    [string]$BashPath,
+    [string]$PythonPath,
+    [string]$Config = 'configs/local.yaml',
+    [ValidateSet('i21315','i21314','i21313')][string]$MachineId,
+    [switch]$AllowCudaSelftest,
+    [switch]$AllowTrainingSmoke,
+    [switch]$FullSuite,
+    [Parameter(ValueFromRemainingArguments=$true)][string[]]$QAArguments
+)
+$ErrorActionPreference = 'Stop'
+$projectRoot = Split-Path -Parent $PSScriptRoot
+Set-Location -LiteralPath $projectRoot
+$logRoot = Join-Path $projectRoot 'logs_qa'
+New-Item -ItemType Directory -Path $logRoot -Force | Out-Null
+$stamp = Get-Date -Format 'yyyyMMdd_HHmmss_fffffff'
+$bootDir = Join-Path $logRoot ("bootstrap_" + $env:COMPUTERNAME + "_" + $stamp)
+New-Item -ItemType Directory -Path $bootDir | Out-Null
+if ($PythonPath) { $env:BOTRYTIS_PYTHON = $PythonPath }
+$candidates = @()
+if ($BashPath) {
+    $candidates += $BashPath
+} else {
+    foreach ($prefix in @($env:ProgramFiles, ${env:ProgramFiles(x86)}, $env:LOCALAPPDATA)) {
+        if ($prefix) {
+            $candidates += (Join-Path $prefix 'Git\bin\bash.exe')
+            $candidates += (Join-Path $prefix 'Programs\Git\bin\bash.exe')
+        }
+    }
+    $found = Get-Command bash.exe -ErrorAction SilentlyContinue
+    if ($found) { $candidates += $found.Source }
+}
+$selected = $null
+foreach ($candidate in ($candidates | Select-Object -Unique)) {
+    if (-not (Test-Path -LiteralPath $candidate)) { continue }
+    try {
+        $probe = & $candidate --noprofile --norc -c 'printf "BOTRYTIS_BASH_%s\n" "$BASH_VERSION"' 2>&1
+        if ($LASTEXITCODE -eq 0 -and ($probe -match 'BOTRYTIS_BASH_[0-9]')) {
+            $selected = $candidate
+            break
+        }
+    } catch { $_ | Out-String | Add-Content -LiteralPath (Join-Path $bootDir 'probe_errors.log') }
+}
+if (-not $selected) {
+    @{
+        status='BLOCKED'; reason='No se encontro Bash funcional. Instale o indique uno; no se instala WSL ni Git automaticamente.'
+        candidates=$candidates; time=(Get-Date).ToString('o')
+    } | ConvertTo-Json -Depth 4 | Set-Content -LiteralPath (Join-Path $bootDir 'result.json') -Encoding UTF8
+    Write-Error 'Bash no disponible. Evidencia en logs_qa. Indique -BashPath C:\ruta\bash.exe.'
+    exit 3
+}
+@{status='PASS'; bash=$selected; time=(Get-Date).ToString('o')} |
+    ConvertTo-Json | Set-Content -LiteralPath (Join-Path $bootDir 'result.json') -Encoding UTF8
+$forward = @('--config', $Config)
+if ($MachineId) { $forward += @('--machine-id', $MachineId) }
+if ($AllowCudaSelftest) { $forward += '--allow-cuda-selftest' }
+if ($AllowTrainingSmoke) { $forward += '--allow-training-smoke' }
+if ($FullSuite) { $forward += '--full-suite' }
+if ($QAArguments) { $forward += $QAArguments }
+& $selected --noprofile --norc scripts/qa.sh @forward 2>&1 |
+    Tee-Object -FilePath (Join-Path $bootDir 'console.log')
+$qaExit = $LASTEXITCODE
+exit $qaExit
--- a/scripts/Prepare-Environment.ps1
+++ b/scripts/Prepare-Environment.ps1
@@ -0,0 +1,27 @@
+param(
+    [Parameter(Mandatory=$true)][string]$PythonExecutable,
+    [Parameter(Mandatory=$true)][string]$TorchVersion,
+    [Parameter(Mandatory=$true)][string]$TorchvisionVersion,
+    [Parameter(Mandatory=$true)][string]$TorchIndexUrl
+)
+$ErrorActionPreference = 'Stop'
+Set-Location -LiteralPath (Split-Path -Parent $PSScriptRoot)
+if ($TorchIndexUrl -notmatch '^https://download\.pytorch\.org/whl/cu[0-9]+/?$') {
+    throw 'Indique un indice CUDA oficial verificado para el driver real.'
+}
+if ($TorchVersion -notmatch '^[0-9]+\.[0-9]+\.[0-9]+$' -or $TorchvisionVersion -notmatch '^[0-9]+\.[0-9]+\.[0-9]+$') {
+    throw 'Las versiones deben ser exactas, numericas y la pareja debe comprobarse en PyTorch.'
+}
+& $PythonExecutable -c 'import os,sys; assert os.name=="nt" and sys.version_info>=(3,10); print(sys.executable,sys.version)'
+if ($LASTEXITCODE -ne 0) { throw 'Python Windows >=3.10 no disponible.' }
+if (Test-Path -LiteralPath '.venv') { throw 'Ya existe .venv; no se modifica silenciosamente.' }
+& $PythonExecutable -m venv .venv
+if ($LASTEXITCODE -ne 0) { throw 'No se pudo crear .venv.' }
+$python = Join-Path (Get-Location) '.venv\Scripts\python.exe'
+& $python -m pip install "torch==$TorchVersion" "torchvision==$TorchvisionVersion" --index-url $TorchIndexUrl
+if ($LASTEXITCODE -ne 0) { throw 'Instalacion PyTorch fallida.' }
+& $python -m pip install -r requirements.txt -r requirements-dev.txt
+if ($LASTEXITCODE -ne 0) { throw 'Dependencias fallidas.' }
+& $python -m pip check
+if ($LASTEXITCODE -ne 0) { throw 'Dependencias incompatibles.' }
+Write-Output 'Entorno creado. Todavia requiere QA; no se comprobo CUDA ni se inicio entrenamiento.'
--- a/scripts/qa.sh
+++ b/scripts/qa.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+# QA autonomo: no instala paquetes ni inicia el experimento oficial.
+set -uo pipefail
+script_dir="${BASH_SOURCE[0]%/*}"
+if [[ "$script_dir" == "${BASH_SOURCE[0]}" ]]; then script_dir="."; fi
+cd -- "$script_dir/.." || exit 2
+export PYTHONIOENCODING=utf-8
+export PYTHONUTF8=1
+export PYTHONDONTWRITEBYTECODE=1
+pycmd=()
+if [[ -n "${BOTRYTIS_PYTHON:-}" ]]; then
+  pycmd=("$BOTRYTIS_PYTHON")
+elif [[ -f .venv/Scripts/python.exe ]]; then
+  pycmd=("./.venv/Scripts/python.exe")
+elif [[ -f .venv/bin/python ]]; then
+  pycmd=("./.venv/bin/python")
+else
+  for candidate in python.exe python3 python; do
+    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3,10))' >/dev/null 2>&1; then
+      pycmd=("$candidate"); break
+    fi
+  done
