+"""Prepara rutas y extrae SOLO datos activos del ZIP local; no crea splits ni entrena."""
+from __future__ import annotations
+import argparse
+import json
+import os
+import shutil
+import sys
+import tempfile
+import zipfile
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+from orchestration.machine import MACHINES, machine_paths, bind
+from orchestration.exchange import _safe_name
+from utils.config_loader import load_config
+from utils.durable import atomic_json
+from utils.hashing import sha256_file
+
+def extract_active(zip_path, destination):
+    """No mezcla _off/editor/respaldo con images/labels; no toca el ZIP."""
+    digest = sha256_file(zip_path)
+    destination = Path(destination) / digest
+    marker = destination / "extraction.json"
+    if marker.exists():
+        if json.loads(marker.read_text(encoding="utf-8"))["zip_sha256"] != digest:
+            raise RuntimeError("Extraccion existente de otro ZIP")
+        return destination
+    with zipfile.ZipFile(zip_path) as z:
+        seen = set()
+        for info in z.infolist():
+            n = info.filename.rstrip("/")
+            _safe_name(n)
+            if n.casefold() in seen:
+                raise ValueError("Miembros duplicados en dataset ZIP")
+            seen.add(n.casefold())
+            if ((info.external_attr >> 16) & 0o170000) == 0o120000:
+                raise ValueError("Symlink en dataset ZIP")
+        bad = z.testzip()
+        if bad:
+            raise ValueError(f"CRC invalido: {bad}")
+        roots = {str(Path(i.filename).parent.parent).replace("\\", "/") for i in z.infolist()
+                 if not i.is_dir() and "/images/" in i.filename and
+                 Path(i.filename).parent.name == "images" and not any(p.startswith("_") for p in Path(i.filename).parts)}
+        if len(roots) != 1:
+            raise ValueError(f"Raiz activa ambigua: {roots}")
+        source_root = roots.pop()
+        chosen = [(i, i.filename[len(source_root) + 1:]) for i in z.infolist()
+                  if not i.is_dir() and i.filename.startswith(source_root + "/") and
+                  (i.filename[len(source_root) + 1:].split("/")[0] in {"images", "labels"} or
+                   i.filename[len(source_root) + 1:] == "classes.txt")]
+        if not chosen:
+            raise ValueError("No se encontraron images/labels activos")
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        required = sum(i.file_size for i, rel in chosen)
+        if shutil.disk_usage(destination.parent).free < required + (16 << 20):
+            raise OSError("Espacio insuficiente para extraer datos activos")
+        temp = Path(tempfile.mkdtemp(dir=destination.parent, prefix="extract_", suffix=".partial"))
+        try:
+            for info, rel in chosen:
+                _safe_name(rel)
+                out = temp / rel
+                out.parent.mkdir(parents=True, exist_ok=True)
+                with z.open(info) as inp, out.open("xb") as dst:
+                    shutil.copyfileobj(inp, dst)
+            atomic_json(temp / "extraction.json", {"zip_sha256": digest, "selected_files": len(chosen),
+                                                 "excluded": "_off, editor, revision y otros metadatos"})
+            if destination.exists():
+                raise FileExistsError(destination)
+            os.rename(temp, destination)
+        except BaseException:
+            # .partial se conserva para diagnostico; jamas aparenta ser extraccion final.
+            raise
+    return destination
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--machine-id", choices=MACHINES, required=True)
+    p.add_argument("--pc-id", choices=("PC-01", "PC-02", "PC-03"), required=True)
+    p.add_argument("--mapping-file", type=Path, required=True, help="JSON con la biyeccion explicita de las tres PCs")
+    p.add_argument("--fruit-class-id", type=int, required=True)
+    p.add_argument("--sign-class-id", type=int, required=True)
+    p.add_argument("--split-seed", type=int, required=True, help="Predeclarada por investigador; no se inventa")
+    a = p.parse_args()
+    if a.fruit_class_id == a.sign_class_id or min(a.fruit_class_id, a.sign_class_id) < 0:
+        p.error("IDs de clase distintos y no negativos")
+    mapping = json.loads(a.mapping_file.read_text(encoding="utf-8-sig"))
+    if set(mapping) != {"PC-01", "PC-02", "PC-03"} or set(mapping.values()) != set(MACHINES) or mapping[a.pc_id] != a.machine_id:
+        p.error("Mapa no biyectivo o incompatible con --machine-id/--pc-id")
+    paths = machine_paths(a.machine_id)
+    if os.name != "nt" or not paths["dataset_zip"].is_file():
+        p.error("Requiere Python nativo Windows y el dataset ZIP local indicado por el usuario")
+    active = extract_active(paths["dataset_zip"], ROOT / "data" / "source")
+    classes_path = active / "classes.txt"
+    if not classes_path.is_file():
+        classes_path = active / "labels" / "classes.txt"
+    names = classes_path.read_text(encoding="utf-8-sig").splitlines()
+    print("Clases REALES:", dict(enumerate(names)))
+    if max(a.fruit_class_id, a.sign_class_id) >= len(names):
+        p.error("ID fuera del classes.txt real")
+    if names[a.fruit_class_id].strip() != "fruto" or names[a.sign_class_id].strip() != "signo_visual_compatible":
+        p.error("Los nombres no coinciden con la metodologia; revise el mapeo sin reinterpretarlo automaticamente")
+    local = {"paths": {"raw_images_dir": str(active / "images"), "raw_labels_dir": str(active / "labels")},
+             "classes": {"fruit_class_id": a.fruit_class_id, "sign_class_id": a.sign_class_id},
+             "outer_split": {"seed": a.split_seed},
+             "compute": {"pc_id": a.pc_id, "require_gpu": True},
+             "operations": {"safety_policy_file": "artifacts/safety_policy.json",
+                            "expected_utc_offset_minutes": -300, "max_job_attempts": 3}}
+    import yaml
+    target = ROOT / "configs" / "local.yaml"
+    text = yaml.safe_dump(local, sort_keys=False, allow_unicode=True)
+    if target.exists() and yaml.safe_load(target.read_text(encoding="utf-8")) != local:
+        raise RuntimeError("configs/local.yaml ya existe y difiere; se preserva, revise explicitamente")
+    target.write_text(text, encoding="utf-8", newline="\n")
+    fleet_file = ROOT / "artifacts" / "fleet_mapping.json"
+    if fleet_file.exists() and json.loads(fleet_file.read_text(encoding="utf-8")) != mapping:
+        raise RuntimeError("fleet_mapping.json previo distinto; no se reemplaza")
+    atomic_json(fleet_file, mapping)
+    print(json.dumps(bind(load_config(target), a.machine_id, a.pc_id), indent=2))
+    print("Preparado. No se creo ninguna particion ni se inicio entrenamiento. Ejecute QA.")
+
+if __name__ == "__main__":
+    main()
