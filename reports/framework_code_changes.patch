+        detail = subprocess.run(["nvidia-smi", "-q", "-d", "TEMPERATURE,POWER"], capture_output=True, text=True, timeout=15)
+        (a.output / "nvidia_limits.txt").write_text(detail.stdout + "\n" + detail.stderr, encoding="utf-8")
+        if os.name != "nt":
