+        f"paths.environments_dir={base / 'artifacts/environments'}", f"paths.runs_dir={base / 'runs'}",
+        f"paths.best_configs_dir={base / 'artifacts/best_configs'}"])
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
