+@contextmanager
+def _managed_process(cfg, command, output):
+    proc = subprocess.Popen(command, stdout=output, stderr=subprocess.STDOUT, env=_child_env())
+    try:
+        yield proc
+    finally:
+        if proc.poll() is None:
+            from utils.durable import atomic_json
+            stop = cfg_path(cfg, "paths.queue_dir") / f"stop_{proc.pid}.json"
+            atomic_json(stop, {"reason": "worker interrupted", "action": "controlled_stop"})
+            try:
+                proc.wait(timeout=60)
+            except subprocess.TimeoutExpired:
+                import psutil
+                try:
+                    parent = psutil.Process(proc.pid)
+                    descendants = parent.children(recursive=True)
+                    for child in descendants:
+                        child.terminate()
+                    parent.terminate()
+                    _, alive = psutil.wait_procs(descendants + [parent], timeout=5)
+                    for child in alive:
+                        child.kill()
+                finally:
+                    proc.wait(timeout=15)
+            finally:
+                stop.unlink(missing_ok=True)
